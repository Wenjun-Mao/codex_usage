{
  "name": "codex-usage-dashboard",
  "displayName": "Codex Usage Companion",
  "description": "Standalone VS Code usage dashboard with a bundled, parent-bound local collector.",
  "publisher": "wenjun-mao",
  "version": "2.3.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/Wenjun-Mao/codex_usage.git" },
  "bugs": { "url": "https://github.com/Wenjun-Mao/codex_usage/issues" },
  "homepage": "https://github.com/Wenjun-Mao/codex_usage#readme",
  "keywords": ["codex", "tokens", "usage", "dashboard", "task-transfer", "local-first"],
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization", "Other"],
  "extensionKind": ["ui"],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": { "supported": true, "description": "The companion only talks to the local Codex Usage collector and does not execute workspace code." }
  },
  "activationEvents": [
    "onCommand:codexUsage.openDashboard",
    "onCommand:codexUsage.captureNow",
    "onCommand:codexUsage.openTaskTransfer",
    "onCommand:codexUsage.analyzeTaskStorage",
    "onCommand:codexUsage.configure",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "codexUsage.openDashboard", "title": "Codex Usage: Open Dashboard" },
      { "command": "codexUsage.captureNow", "title": "Codex Usage: Capture Usage" },
      { "command": "codexUsage.refreshDashboard", "title": "Codex Usage: Reload Current View" },
      { "command": "codexUsage.selectRange", "title": "Codex Usage: Select Range" },
      { "command": "codexUsage.selectProjects", "title": "Codex Usage: Select Projects" },
      { "command": "codexUsage.selectTheme", "title": "Codex Usage: Select Theme" },
      { "command": "codexUsage.reviewProjectTransitions", "title": "Codex Usage: Review Project Transitions" },
      { "command": "codexUsage.showUsageView", "title": "Codex Usage: Show Usage" },
      { "command": "codexUsage.showStorageView", "title": "Codex Usage: Show Task Storage" },
      { "command": "codexUsage.openTaskTransfer", "title": "Codex Usage: Task Transfer" },
      { "command": "codexUsage.importTasks", "title": "Codex Usage: Import Tasks" },
      { "command": "codexUsage.exportTasks", "title": "Codex Usage: Export Tasks" },
      { "command": "codexUsage.reviewTransferStatus", "title": "Codex Usage: Review Transfer Status" },
      { "command": "codexUsage.chooseTransferFolder", "title": "Codex Usage: Choose Transfer Folder" },
      { "command": "codexUsage.analyzeTaskStorage", "title": "Codex Usage: Analyze Task Storage" },
      { "command": "codexUsage.configure", "title": "Codex Usage: Set Up Collector" },
      { "command": "codexUsage.openNativeApp", "title": "Codex Usage: Open Native App" }
    ],
    "configuration": {
      "title": "Codex Usage Companion",
      "properties": {
        "codexUsage.range": { "type": "string", "enum": ["today", "yesterday", "7d", "30d", "month", "all"], "default": "30d", "description": "Time range requested from the Codex Usage ledger." },
        "codexUsage.theme": { "type": "string", "enum": ["auto", "day", "night"], "default": "auto", "description": "Dashboard report theme." }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean-output.js",
    "build": "npm run clean && tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run build && node --test test/*.test.js",
    "test:package:mac": "npm run build && node scripts/verify-package.js --target darwin-arm64",
    "test:package:win": "npm run build && node scripts/verify-package.js --target win32-x64",
    "build:agent:mac": "bash scripts/build-agent-macos-arm64.sh",
    "build:agent:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-agent-windows-x64.ps1",
    "package:vsix:mac": "npm run build:agent:mac && node scripts/package-vsix.js darwin-arm64",
    "package:vsix:win": "npm run build:agent:win && node scripts/package-vsix.js win32-x64",
    "package:vsix": "npm run package:vsix:mac",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.7.2"
  }
}
